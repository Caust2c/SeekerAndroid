<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/livePlayer" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:orientation="vertical" android:padding="10dp" android:background="@drawable/player_surface">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <LinearLayout android:id="@+id/liveExpand" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:contentDescription="@string/player_expand">
   <ImageView android:id="@+id/liveArtwork" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/player_cover" android:scaleType="centerCrop" android:contentDescription="@string/player_artwork"/>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
    <TextView android:id="@+id/liveFilename" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/liveStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#B9D2DF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
   </LinearLayout>
   <ImageView android:layout_width="20dp" android:layout_height="24dp" android:layout_marginHorizontal="4dp" android:src="@drawable/player_expand" android:importantForAccessibility="no"/>
  </LinearLayout>
  <ImageButton android:id="@+id/livePlayPause" android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:background="@drawable/player_accent" android:src="@drawable/player_play" android:contentDescription="@string/miniplayer_play"/>
  <ImageButton android:id="@+id/liveClose" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="20dp" android:padding="14dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/player_close" android:contentDescription="@string/miniplayer_close"/>
 </LinearLayout>
 <ProgressBar android:id="@+id/livePlaybackProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="6dp" android:progressTint="#70D5CF" android:progressBackgroundTint="#385064" android:contentDescription="@string/miniplayer_playback_progress"/>
</LinearLayout>