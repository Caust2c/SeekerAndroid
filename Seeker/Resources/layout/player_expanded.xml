<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:paddingBottom="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <ImageButton android:id="@+id/playerCollapse" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_expand_more_black_32dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/player_collapse" android:tint="?attr/cellTextColor" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/player_now_playing" android:textSize="14sp" android:textColor="?attr/cellTextColorSubdued" />
            <ImageButton android:id="@+id/playerClose" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/close_20dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/miniplayer_close" android:tint="?attr/cellTextColor" />
        </LinearLayout>
        <ImageView android:id="@+id/playerArtwork" android:layout_width="280dp" android:layout_height="280dp" android:layout_marginTop="20dp" android:layout_marginBottom="24dp" android:scaleType="centerCrop" android:src="@drawable/player_cover" android:contentDescription="@string/player_artwork" />
        <TextView android:id="@+id/playerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/cellTextColor" android:textSize="25sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/playerArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="?attr/cellTextColorSubdued" android:textSize="17sp" />
        <TextView android:id="@+id/playerAlbum" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="?attr/cellTextColorMoreSubdued" android:textSize="13sp" />
        <TextView android:id="@+id/playerQuality" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="?attr/slskAccent" android:textSize="11sp" />
        <ProgressBar android:id="@+id/playerProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="24dp" android:progressTint="?attr/slskAccent" android:progressBackgroundTint="?attr/slightContrastColor" android:contentDescription="@string/miniplayer_playback_progress" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <TextView android:id="@+id/playerElapsed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="?attr/cellTextColorSubdued" android:textSize="12sp" />
            <TextView android:id="@+id/playerDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/cellTextColorSubdued" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/playerPlayPause" android:layout_width="80dp" android:layout_height="80dp" android:layout_marginTop="18dp" android:padding="24dp" android:src="@drawable/player_play" android:background="@drawable/player_accent" android:contentDescription="@string/miniplayer_play" android:tint="?attr/colorOnPrimary" />
        <TextView android:id="@+id/playerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:textColor="?attr/cellTextColorSubdued" android:textSize="13sp" />
        <TextView android:id="@+id/playerDownloadLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textColor="?attr/cellTextColorMoreSubdued" android:textSize="12sp" />
        <ProgressBar android:id="@+id/playerDownloadProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="8dp" android:max="100" android:progressTint="?attr/slskAccent" android:contentDescription="@string/miniplayer_download_progress" />
        <Button android:id="@+id/playerRetry" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="16dp" android:text="@string/player_retry" android:visibility="gone" style="@style/SeekerButtonStyle" />
    </LinearLayout>
</ScrollView>
